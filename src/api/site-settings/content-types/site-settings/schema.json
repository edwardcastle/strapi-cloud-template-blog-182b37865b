    "navHomeEn": {
      "type": "string",
      "default": "Home"
    },
    "navHomeFr": {
      "type": "string",
      "default": "Accueil"
    },
    "navArtistsEs": {
      "type": "string",
      "default": "Artistas"
    },
    "navArtistsEn": {
      "type": "string",
      "default": "Artists"
