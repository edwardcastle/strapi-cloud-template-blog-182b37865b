      "type": "string",
      "default": "About Us"
    },
    "navAboutFr": {
      "type": "string",
      "default": "À Propos"
    },
    "navContactEs": {
      "type": "string",
      "default": "Contacto"
    },
    "navContactEn": {
      "type": "string",
      "default": "Contact"
    },
    "navContactFr": {
      "type": "string",
      "default": "Contact"
    },
    "footerDescriptionEs": {
      "type": "text"
    },
    "footerDescriptionEn": {
      "type": "text"
    },
    "footerDescriptionFr": {
      "type": "text"
    },
    "footerCopyrightEs": {
      "type": "string"
    },
    "footerCopyrightEn": {
      "type": "string"
    },
    "footerCopyrightFr": {
      "type": "string"
    }
