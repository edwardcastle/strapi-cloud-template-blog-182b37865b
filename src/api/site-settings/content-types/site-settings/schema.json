      "required": true
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "youtube": {
      "type": "string"
    },
    "navHomeEs": {
      "type": "string",
      "default": "Inicio"
